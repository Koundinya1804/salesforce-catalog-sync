# ------------------------------------------------------------------------------ #
# Java defaults (https://github.com/github/gitignore/blob/master/Java.gitignore) #
# ------------------------------------------------------------------------------ #
*.class

# Package Files #
*.jar
*.war
*.ear

# ------------------------------------------------------------------------------------------- #
# Eclipse-specific (https://github.com/github/gitignore/blob/master/Global/Eclipse.gitignore) #
# ------------------------------------------------------------------------------------------- #
*.pydevproject
.metadata
bin/**
tmp/**
tmp/**/*
*.tmp
*.bak
*.swp
*~.nib
local.properties
.settings/
.loadpath
.project
.classpath

# External tool builders
.externalToolBuilders/

# Locally stored "Eclipse launch configurations"
*.launch

# CDT-specific
.cproject

# PDT-specific
.buildpath

# --------------- #
# Studio-specific #
# --------------- #
target/
.mule/
.DS_Store
velocity.log

# Secrets & Environment Properties with live credentials
*.jks
*.p12
*.key
*.pem

# Local test runs and scratch
__pycache__/
*.pyc
test_part*.py
# Local integration credentials
src/main/resources/config.yaml
src/main/resources/secure-properties.yaml
src/main/resources/config-aiven.yaml
src/main/resources/secure-properties-aiven.yaml
deployment/aiven.properties
# Generated coverage HTML can embed environment-specific source.
reports/
